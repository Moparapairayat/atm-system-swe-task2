        </mxCell>
        <mxCell id="tr7" value="Select Withdrawal" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="st_menu" target="st_proc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr8" value="Approved" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="st_proc" target="st_disp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr9" value="Cash Delivered" style="endArrow=classic;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="st_disp" target="st_eject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr10" value="Card Removed" style="endArrow=classic;html=1;exitX=0.5;exitY=0;entryX=0;entryY=0.75;" edge="1" parent="1" source="st_eject" target="st_idle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

