        </mxCell>

        <mxCell id="st_disp" value="Dispensing Cash" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="690" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="st_eject" value="Ejecting Card" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="320" y="690" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="st_maint" value="Maintenance Mode" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="900" y="270" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="st_out" value="Out of Service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="900" y="125" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Transitions -->
        <mxCell id="tr1" value="Power On" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="st_init" target="st_off">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr2" value="Boot" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="st_off" target="st_selftest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr3" value="OK" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="st_selftest" target="st_idle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr4" value="Fault" style="endArrow=classic;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="st_selftest" target="st_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tr5" value="Insert Card" style="endArrow=classic;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="st_idle" target="st_pin">
