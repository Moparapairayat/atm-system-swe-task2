        </mxCell>

        <mxCell id="st_pin" value="PIN Verification" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="270" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="st_menu" value="Transaction Menu" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="600" y="410" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="st_proc" value="Processing Transaction" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
